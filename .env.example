# ==============================================================================
# GCP Android Build Farm - Environment & Secrets Configuration Template
#
# Copy this file to '.env' and fill in your settings and credentials:
#   cp .env.example .env
#
# Upload to your GCP VM anytime via:
#   Option 6) Upload .env Credentials (in Tools Menu)
#   or ./gcp_menu.sh upload-env
# (Securely saved to ~/.build_env with chmod 600 on the VM boot disk)
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Platform (GCP) Configuration
# ------------------------------------------------------------------------------
# Target GCP project ID (leave blank to auto-detect from active gcloud config)
GCP_PROJECT="project-53211141-f92a-48c1-b88"

# Target compute instance name and zone
GCP_INSTANCE="rom-build-farm"
GCP_ZONE="us-central1-a"

# Secondary SSD storage disk name (500GB pd-balanced shared fallback disk)
GCP_GENERAL_DISK="gcp-general-disk"

# Default machine type for builds (e.g. t2d-standard-16, c2d-standard-16)
GCP_MACHINE_TYPE="t2d-standard-16"

# ------------------------------------------------------------------------------
# SourceForge Release Publishing
# ------------------------------------------------------------------------------
SF_USER="nikhilpal2705"
SF_PROJECT="realme-atoll"
# Path to local SSH private key on your Mac (e.g. ~/.ssh/crave_sf)
SF_KEY_PATH="~/.ssh/crave_sf"
# Base64 encoded private key (alternative if no local file path is used on the VM)
SF_KEY=""

# ------------------------------------------------------------------------------
# Cloud Upload Tokens (Gofile / Telegram / Discord)
# ------------------------------------------------------------------------------
# Optional Gofile VIP Account API token (for unlimited folder retention)
GOFILE_TOKEN=""

# Telegram Bot Token (from @BotFather) & Chat ID (from @userinfobot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Discord Webhook URL (from Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# Build & Upload Preferences
# ------------------------------------------------------------------------------
# Default uploads when running builds
DEFAULT_SF_UPLOAD="false"
DEFAULT_GOFILE_UPLOAD="true"

# Automatically power off VM on build success (true/false)
DEFAULT_AUTO_SHUTDOWN="true"
